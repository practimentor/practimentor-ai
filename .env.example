# Copiar como .env en desarrollo local. NUNCA subir el .env real a git.

# Proveedor de IA (ver ADR 2026-08-23-04). Gemini es el proveedor por defecto.
GOOGLE_API_KEY=

# Proveedor alternativo, configurable pero no obligatorio en el MVP.
ANTHROPIC_API_KEY=

# Base vectorial
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Almacenamiento de archivos
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=utp-agent-documents

# API academica, para verificar autorizacion antes de responder
ACADEMIC_API_URL=http://localhost:5000

LOG_LEVEL=INFO
